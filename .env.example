# prisma dev kører én database (template1). Migreringer bruger den separate skygge-server.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"
APP_URL="http://localhost:3000"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# MAIL_FROM="ESG Rapportering <noreply@example.com>"
# Tillad at nye brugere selv kan logge ind og oprette en koncern (ellers kun via invitation)
ALLOW_SIGNUP="true"
# Identifikation over for cvrapi.dk ved CVR-opslag (de beder om projektnavn og kontakt)
# CVR_USER_AGENT="Mit projekt - kontakt@example.com"
# Identifikation over for Nominatim (OpenStreetMap) ved geokodning af adresser
# GEOCODE_USER_AGENT="Mit projekt - kontakt@example.com"
# Platformens ejere (kommasepareret): adgang til admin-dashboardet på /admin
# PLATFORM_ADMIN_EMAILS="ejer@example.com"
# Sti til LibreOffice, hvis PDF-eksporten ikke finder soffice selv
# SOFFICE_PATH="/usr/bin/soffice"
