// ESG-rapportering – datamodel (fase 1: fundament)
// Hierarki: Organization (koncern/kunde) → Company (selskab, med parent) → Location

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Brugere og login ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  /// Sidste gang brugeren loggede ind via et login-link
  lastLoginAt DateTime?
  /// Spærret af platformens ejer: kan ikke logge ind, og eksisterende sessioner virker ikke
  disabledAt  DateTime?

  sessions            Session[]
  memberships         Membership[]
  invitationsSent     Invitation[] @relation("InvitedBy")
  auditLogs           AuditLog[]
  moduleEdits         ModuleData[]
  attachments         Attachment[]
  submissionsSent     CompanySubmission[] @relation("SubmittedBy")
  submissionsReviewed CompanySubmission[] @relation("ReviewedBy")
  adminActions        AdminLog[]
}

/// Handlinger foretaget i platformens admin-dashboard (på tværs af koncerner)
model AdminLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // fx user.disable
  targetType String
  targetId   String
  data       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Engangs-login-link sendt pr. mail
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  redirectTo String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ---------- Organisation ----------

/// En koncern/kunde. Al data er isoleret pr. organisation.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  /// Logo til eksporterede rapporter (PNG/JPEG i fil-lagringen)
  logoKey         String?
  logoContentType String?
  logoUpdatedAt   DateTime?

  companies   Company[]
  memberships Membership[]
  invitations Invitation[]
  periods     ReportingPeriod[]
  auditLogs   AuditLog[]
  factorSets  FactorSet[]
}

enum LegalForm {
  PMV       // Personligt ejet mindre virksomhed
  ENKELTMAND
  IS        // Interessentskab
  APS
  AS
  KS
  ANDET
}

/// Et selskab (CVR). parentId = null betyder øverste moderselskab.
model Company {
  id             String     @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  cvr            String
  address        String?
  legalForm      LegalForm?
  naceCodes      String[]   @default([])
  /// Standardvalg for om selskabet medtages i konsoliderede rapporter (kan ændres pr. rapport)
  consolidate    Boolean    @default(true)
  createdAt      DateTime   @default(now())
  archivedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Company?     @relation("CompanyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Company[]    @relation("CompanyTree")
  locations    Location[]
  memberships  Membership[]
  invitations  Invitation[]
  reportsAsReporting Report[]        @relation("ReportingCompany")
  reportLinks        ReportCompany[]
  moduleData         ModuleData[]
  submissions        CompanySubmission[]

  @@unique([organizationId, cvr])
  @@index([parentId])
}

/// Lokation/facilitet som selskabet ejer, lejer eller driver/forvalter
model Location {
  id        String          @id @default(cuid())
  companyId String
  name      String          // fx Kontor, Lager, Industrianlæg
  address   String
  function  String?
  control   LocationControl @default(EJER)
  /// Geolokation (B1 pkt. 27e vi–vii), WGS84 decimalgrader
  latitude  Float?
  longitude Float?
  /// Driftsperiode – tom slutdato betyder i drift
  operationalFrom DateTime?
  operationalTo   DateTime?
  createdAt DateTime        @default(now())
  archivedAt DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]
  moduleData  ModuleData[]

  @@index([companyId])
}

enum LocationControl {
  EJER
  LEJER
  DRIVER // driver/forvalter
}

/// Rapporteringsår (følger regnskabsåret)
model ReportingPeriod {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      Report[]
  moduleData   ModuleData[]
  submissions  CompanySubmission[]
  /// Faktorsæt beregningerne for året bruger. Tom = standardsættet.
  factorSetId  String?
  factorSet    FactorSet?   @relation(fields: [factorSetId], references: [id], onDelete: SetNull)

  @@unique([organizationId, year])
}

// ---------- Rapportopsætning ----------
// Data indsamles pr. selskab og rapporteringsår. En rapport er en "visning" over et udvalg af selskaber,
// så samme data kan indgå i både en koncernrapport og fx en individuel rapport for et datterselskab.

enum ReportModule {
  BASIC                   // Basismodul (B1–B11)
  BASIC_AND_COMPREHENSIVE // Basismodul + Udvidet Modul (B + C1–C9)
}

enum ReportBasis {
  INDIVIDUAL   // kun det rapporterende selskab
  CONSOLIDATED // rapporterende selskab + udvalgte datterselskaber
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

model Report {
  id                   String       @id @default(cuid())
  periodId             String
  name                 String
  standardVersion      String       @default("VS (EU-Kommissionens henstilling 2025)")
  module               ReportModule @default(BASIC)
  basis                ReportBasis  @default(CONSOLIDATED)
  /// Det rapporterende selskab (moderselskab ved konsolideret rapport)
  reportingCompanyId   String
  /// Undtagelser og udeladelser (B1) – struktureres pr. VS-punkt i fase 2
  omissions            String?
  /// Koncernens konsoliderede omsætning (kr.) fra koncernregnskabet – bruges til CO2e-intensitet,
  /// så koncerninterne salg ikke tælles med. Tom = summen af selskabernes omsætning.
  consolidatedTurnover Float?
  status               ReportStatus @default(DRAFT)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  period           ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reportingCompany Company         @relation("ReportingCompany", fields: [reportingCompanyId], references: [id])
  companies        ReportCompany[]

  @@index([periodId])
}

/// Selskaber der er omfattet af rapporten
model ReportCompany {
  reportId  String
  companyId String

  report  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([reportId, companyId])
}

// ---------- Adgang ----------

enum Role {
  ORG_ADMIN            // Koncernadmin: alt i organisationen
  COMPANY_MANAGER      // Selskabsansvarlig: ét selskab + dets lokationer
  LOCATION_CONTRIBUTOR // Lokationsbidragyder: én lokation
  VIEWER               // Læser/revisor: alt read-only
}

/// Scope: ORG_ADMIN/VIEWER → kun organizationId. COMPANY_MANAGER → companyId. LOCATION_CONTRIBUTOR → locationId.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  companyId      String?
  locationId     String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role, companyId, locationId])
  @@index([organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  role           Role
  companyId      String?
  locationId     String?
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // fx company.create
  entityType     String
  entityId       String
  data           Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ---------- Indrapportering (fase 2) ----------
// Ét sæt svar pr. modul pr. mål (selskab eller lokation) pr. rapporteringsår.
// Svarene ligger som JSON valideret mod modul-definitionen i src/lib/forms.

enum ModuleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED    // markeret færdig af brugeren (alle krævede felter udfyldt eller begrundet)
  NOT_RELEVANT // hele modulet er ikke relevant, med begrundelse
}

model ModuleData {
  id          String       @id @default(cuid())
  periodId    String
  moduleKey   String       // fx "company.general"
  /// "company:<id>" eller "location:<id>" – én kolonne, så unik-nøglen virker uden NULL-problemer
  targetKey   String
  companyId   String
  locationId  String?
  answers     Json         @default("{}")
  status      ModuleStatus @default(NOT_STARTED)
  statusNote  String?
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  period      ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location    Location?       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  updatedBy   User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([periodId, moduleKey, targetKey])
  @@index([companyId, periodId])
}

/// Dokumentationsfil knyttet til en sektion i et modul
model Attachment {
  id           String   @id @default(cuid())
  moduleDataId String
  sectionKey   String
  filename     String
  contentType  String
  size         Int
  storageKey   String   @unique
  uploadedById String?
  createdAt    DateTime @default(now())

  moduleData ModuleData @relation(fields: [moduleDataId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([moduleDataId])
}

// ---------- Emissionsfaktorer (fase 3) ----------
// Globale sæt (organizationId = null) importeres fra fx Klimakompasset.
// En organisation kan oprette egne sæt (kopi af et globalt sæt) og rette enkelte faktorer.

model FactorSet {
  id             String   @id @default(cuid())
  name           String
  version        String
  description    String?
  sourceUrl      String?
  isDefault      Boolean  @default(false)
  organizationId String?
  basedOnId      String?
  createdAt      DateTime @default(now())

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  basedOn      FactorSet?        @relation("FactorSetCopy", fields: [basedOnId], references: [id], onDelete: SetNull)
  copies       FactorSet[]       @relation("FactorSetCopy")
  factors      EmissionFactor[]
  periods      ReportingPeriod[]

  @@index([organizationId])
}

/// kg CO2e pr. enhed, opdelt på scope. Nøglen følger Klimakompassets nøgleformat.
model EmissionFactor {
  id            String  @id @default(cuid())
  setId         String
  year          Int
  key           String
  mainCategory  String
  category      String
  parameter1    String?
  parameter2    String?
  unit          String
  scope1        Float   @default(0)
  scope2        Float   @default(0)
  scope3        Float   @default(0)
  outsideScopes Float   @default(0)
  source        String?
  /// Rettet af organisationen (kun i egne sæt)
  customized    Boolean @default(false)

  set FactorSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, year, key])
  @@index([setId, year, category])
}

// ---------- Gennemgang (fase 4) ----------
// Selskabet indsender sine data for året; koncernadmin godkender eller sender tilbage med en kommentar.
// Data er låst, mens de er indsendt eller godkendt.

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

model CompanySubmission {
  id            String           @id @default(cuid())
  periodId      String
  companyId     String
  status        SubmissionStatus @default(DRAFT)
  comment       String?
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  updatedAt     DateTime         @updatedAt

  period      ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy User?           @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?           @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([periodId, companyId])
}
